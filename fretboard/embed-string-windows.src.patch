@@ -0,0 +1,72 @@
+/**
+ * String windows — playing a 10-string pedal-steel tuning on a 6-string
+ * instrument by picking a contiguous run of six strings ("play strings 3–8").
+ *
+ * Windows are named by pedal-steel string numbers: string 1 is the top row as
+ * drawn (the treble side), string 10 the bottom. The catalog's midi arrays run
+ * low string first, so window "3–8" (strings 8..3) is the slice starting at
+ * index 2. Windows are listed in string-number order (1–6 first) — the order
+ * the VG-800 host app shows them in; ids are the ASCII contract shared with
+ * that host's bridge, labels the pretty en-dash forms.
+ */
+import type { Tuning } from './tunings';
+
+export interface StringWindow {
+  /** Stable ASCII id, shared with the VG-800 host bridge ('3-8'). */
+  id: string;
+  /** Display label with a proper en dash ('3–8'). */
+  label: string;
+  /** Index of the window's bottom string in the low-first midi array. */
+  i0: number;
+  /** Why a player picks this window. */
+  desc: string;
+}
+
+export const WINDOW_SIZE = 6;
+
+/** In string-number order, 1–6 → 5–10 — the top of the neck to the bottom. */
+export const STRING_WINDOWS: StringWindow[] = [
+  { id: '1-6', label: '1–6', i0: 4, desc: 'the top strings' },
+  { id: '3-8', label: '3–8', i0: 2, desc: 'the classic 6-string country setup' },
+  { id: '4-9', label: '4–9', i0: 1, desc: 'a lower, fuller voicing' },
+  { id: '5-10', label: '5–10', i0: 0, desc: 'the low strings' },
+];
+
+/** Where a steel tuning lands first: the classic country grip. */
+export const DEFAULT_WINDOW_ID = '3-8';
+
+export function getWindow(id: string | null | undefined): StringWindow | null {
+  return STRING_WINDOWS.find((w) => w.id === id) ?? null;
+}
+
+/** Tunings that offer windows: the 10-string pedal-steel necks. */
+export function hasStringWindows(t: Tuning): boolean {
+  return t.group === 'pedal-steel' && t.midi.length === 10;
+}
+
+/** True when a stack does not ascend (E9's chromatic strings dip back down). */
+export function isReentrant(midi: number[]): boolean {
+  return midi.some((m, i) => i > 0 && m < midi[i - 1]);
+}
+
+/** The window's string numbers, bottom row and top row ('3-8' → 8 and 3). */
+export function windowSpan(w: StringWindow): { top: number; bottom: number } {
+  const [top, bottom] = w.id.split('-').map(Number);
+  return { top, bottom };
+}
+
+/**
+ * The 6-string Tuning a window cuts from a 10-string neck. Keeps the parent's
+ * name/description/key/copedent — only the strings change, plus the re-entrant
+ * flag, recomputed for the slice (3–8 of the E9 ascends cleanly; 1–6 keeps the
+ * chromatic dip). The id is suffixed so the cut can never shadow a catalog
+ * entry.
+ */
+export function windowedTuning(t: Tuning, w: StringWindow): Tuning {
+  const midi = t.midi.slice(w.i0, w.i0 + WINDOW_SIZE);
+  const spellings = t.spellings.slice(w.i0, w.i0 + WINDOW_SIZE);
+  const cut: Tuning = { ...t, id: `${t.id}::${w.id}`, midi, spellings };
+  if (isReentrant(midi)) cut.reentrant = true;
+  else delete cut.reentrant;
+  return cut;
+}
