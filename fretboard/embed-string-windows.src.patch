@@ -0,0 +1,127 @@
+/**
+ * String windows: the 6-of-10 cuts a 6-string player takes from a pedal-steel
+ * neck. Gates the window table (order, indices, coverage), the cut tunings
+ * (exact slices of the catalog stacks, correct re-entrant flags), and the
+ * host-bridge contract (ids the VG-800 app syncs on).
+ */
+import { describe, expect, test } from 'vitest';
+
+import {
+  DEFAULT_WINDOW_ID,
+  STRING_WINDOWS,
+  WINDOW_SIZE,
+  getWindow,
+  hasStringWindows,
+  isReentrant,
+  windowSpan,
+  windowedTuning,
+} from './stringWindows';
+import { TUNINGS, getTuning } from './tunings';
+import { noteToPitchClass } from './musicTheory';
+
+const steels = TUNINGS.filter((t) => t.group === 'pedal-steel');
+
+describe('the window table', () => {
+  test('runs in string-number order: 1–6, 3–8, 4–9, 5–10', () => {
+    expect(STRING_WINDOWS.map((w) => w.id)).toEqual(['1-6', '3-8', '4-9', '5-10']);
+  });
+
+  test('each window is a real 6-of-10 slice, and together they span every string', () => {
+    const covered = new Set<number>();
+    for (const w of STRING_WINDOWS) {
+      expect(w.i0).toBeGreaterThanOrEqual(0);
+      expect(w.i0 + WINDOW_SIZE).toBeLessThanOrEqual(10);
+      for (let i = w.i0; i < w.i0 + WINDOW_SIZE; i++) covered.add(i);
+    }
+    expect(covered.size).toBe(10);
+  });
+
+  test('ids agree with the string numbers the i0 index implies', () => {
+    // Low-first index i holds string 10-i, so a window starting at i0 covers
+    // strings (10-i0) down to (10-i0-5) — the id must say exactly that.
+    for (const w of STRING_WINDOWS) {
+      const { top, bottom } = windowSpan(w);
+      expect({ id: w.id, top, bottom }).toEqual({
+        id: w.id,
+        top: 10 - (w.i0 + WINDOW_SIZE - 1),
+        bottom: 10 - w.i0,
+      });
+    }
+  });
+
+  test('the default window exists and is the classic 3–8 grip', () => {
+    expect(DEFAULT_WINDOW_ID).toBe('3-8');
+    expect(getWindow(DEFAULT_WINDOW_ID)?.i0).toBe(2);
+    expect(getWindow('nope')).toBeNull();
+    expect(getWindow(null)).toBeNull();
+  });
+});
+
+describe('which tunings get windows', () => {
+  test('every 10-string pedal-steel neck, and nothing else', () => {
+    expect(steels.length).toBeGreaterThan(0);
+    for (const t of TUNINGS) {
+      expect({ id: t.id, windows: hasStringWindows(t) }).toEqual({
+        id: t.id,
+        windows: t.group === 'pedal-steel',
+      });
+    }
+  });
+});
+
+describe('the cut tunings', () => {
+  test('every window of every steel is the exact catalog slice', () => {
+    for (const t of steels) {
+      for (const w of STRING_WINDOWS) {
+        const cut = windowedTuning(t, w);
+        expect(cut.midi).toEqual(t.midi.slice(w.i0, w.i0 + WINDOW_SIZE));
+        expect(cut.spellings).toEqual(t.spellings.slice(w.i0, w.i0 + WINDOW_SIZE));
+        expect(cut.midi).toHaveLength(WINDOW_SIZE);
+        // Spellings still name the right pitches after the cut.
+        cut.midi.forEach((m, i) => {
+          expect({ t: t.id, w: w.id, i, pc: noteToPitchClass(cut.spellings[i]) }).toEqual({
+            t: t.id,
+            w: w.id,
+            i,
+            pc: ((m % 12) + 12) % 12,
+          });
+        });
+      }
+    }
+  });
+
+  test('a cut keeps its parent identity but cannot shadow a catalog id', () => {
+    for (const t of steels) {
+      const cut = windowedTuning(t, STRING_WINDOWS[1]);
+      expect(cut.name).toBe(t.name);
+      expect(cut.group).toBe(t.group);
+      expect(cut.description).toBe(t.description);
+      expect(cut.key).toEqual(t.key);
+      expect(cut.copedent).toBe(t.copedent);
+      expect(cut.id).toBe(`${t.id}::3-8`);
+      expect(getTuning(cut.id)).toBeUndefined();
+    }
+  });
+
+  test('re-entrant flags follow the slice, not the parent', () => {
+    const e9 = getTuning('ps-e9-nashville')!;
+    expect(e9.reentrant).toBe(true);
+    // 3–8, 4–9 and 5–10 skip the chromatic strings — they ascend cleanly.
+    expect(windowedTuning(e9, getWindow('3-8')!).reentrant).toBeUndefined();
+    expect(windowedTuning(e9, getWindow('4-9')!).reentrant).toBeUndefined();
+    expect(windowedTuning(e9, getWindow('5-10')!).reentrant).toBeUndefined();
+    // 1–6 keeps strings 1–2 (F♯4/D♯4 below string 3's G♯4) — still re-entrant.
+    expect(windowedTuning(e9, getWindow('1-6')!).reentrant).toBe(true);
+
+    // C6's top string (D4) sits below string 2's E4 — 1–6 is re-entrant too.
+    const c6 = getTuning('ps-c6-swing-jazz')!;
+    expect(windowedTuning(c6, getWindow('1-6')!).reentrant).toBe(true);
+    expect(windowedTuning(c6, getWindow('3-8')!).reentrant).toBeUndefined();
+  });
+
+  test('isReentrant: equal neighbours (Lanois doubled strings) do not count', () => {
+    expect(isReentrant([47, 47, 52, 52, 56, 59])).toBe(false);
+    expect(isReentrant([52, 54, 56, 59, 64, 68])).toBe(false);
+    expect(isReentrant([56, 59, 64, 68, 63, 66])).toBe(true);
+  });
+});
