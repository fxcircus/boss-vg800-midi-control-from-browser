+++ b/src/components/StringWindowBar.tsx
@@ -0,0 +1,188 @@
+/**
+ * The string-window selector shown on 10-string pedal-steel tunings when the
+ * board is embedded in the VG-800 app: which six of the ten strings the
+ * player's guitar is set to, plus an "All 10" view of the full neck.
+ *
+ * Every option shows its own voicing so the choice can be made by ear, not by
+ * trial: a 10-dot map of the strings it covers, the string numbers, and the
+ * open notes of the cut. The line underneath explains the selected option in
+ * the same words the VG-800's own Pedal Steel section uses.
+ */
+import React from 'react';
+import styled from 'styled-components';
+
+import { Hint, Label, Row } from './ui';
+import type { Tuning } from '../lib/tunings';
+import {
+  STRING_WINDOWS,
+  WINDOW_SIZE,
+  isReentrant,
+  windowSpan,
+  type StringWindow,
+} from '../lib/stringWindows';
+
+const Section = styled.div`
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding-top: ${({ theme }) => theme.spacing.sm};
+  border-top: 1px solid ${({ theme }) => `${theme.colors.border}66`};
+`;
+
+// A column chip: dot-map on top, the window's numbers, its open notes below —
+// the same reading order as the VG-800's grouping buttons.
+const WinBtn = styled.button<{ $active?: boolean; $ghost?: boolean }>`
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 4px;
+  padding: 6px 10px 5px;
+  border: 1px ${({ $ghost }) => ($ghost ? 'dashed' : 'solid')}
+    ${({ $active, $ghost, theme }) =>
+      $active || $ghost ? theme.colors.primary : theme.colors.border};
+  border-radius: ${({ theme }) => theme.borderRadius.small};
+  cursor: pointer;
+  background: ${({ $active, theme }) => ($active ? `${theme.colors.primary}22` : 'transparent')};
+  color: ${({ $active, theme }) => ($active ? theme.colors.primary : theme.colors.text)};
+  font-family: inherit;
+  font-size: ${({ theme }) => theme.fontSizes.xs};
+  font-weight: 700;
+  transition: all ${({ theme }) => theme.transitions.fast};
+
+  &:hover:not(:disabled) {
+    border-color: ${({ theme }) => theme.colors.primary};
+  }
+
+  &:disabled {
+    cursor: default;
+    opacity: 0.4;
+  }
+`;
+
+const DotRow = styled.span`
+  display: inline-flex;
+  gap: 2px;
+`;
+
+const Dot = styled.i<{ $on: boolean }>`
+  width: 3px;
+  height: 12px;
+  border-radius: 1.5px;
+  background: ${({ $on, theme }) => ($on ? theme.colors.primary : theme.colors.border)};
+  transition: background ${({ theme }) => theme.transitions.fast};
+`;
+
+const WinNotes = styled.span`
+  font-family: ${({ theme }) => theme.monoFamily};
+  font-size: 9px;
+  font-weight: 500;
+  letter-spacing: 0.04em;
+  color: ${({ theme }) => theme.colors.textSecondary};
+  white-space: nowrap;
+`;
+
+export interface StringWindowBarProps {
+  /** The full 10-string catalog tuning the windows cut from. */
+  tuning: Tuning;
+  /** 'win' = the 6-string cut is on the board; 'all' = the full neck. */
+  view: 'win' | 'all';
+  /** The window the host guitar is set to. */
+  activeId: string;
+  /** Window ids the host guitar cannot retune to (shown, but not clickable). */
+  disabled: string[];
+  onPickWindow: (id: string) => void;
+  onPickAll: () => void;
+}
+
+const StringWindowBar: React.FC<StringWindowBarProps> = ({
+  tuning,
+  view,
+  activeId,
+  disabled,
+  onPickWindow,
+  onPickAll,
+}) => {
+  const strings = tuning.midi.length;
+  const cutOf = (w: StringWindow) => ({
+    midi: tuning.midi.slice(w.i0, w.i0 + WINDOW_SIZE),
+    notes: tuning.spellings.slice(w.i0, w.i0 + WINDOW_SIZE).join(' '),
+  });
+
+  // Dots read left→right as string 1..10, matching the VG-800's grouping
+  // buttons; the midi array is low-first, so dot d maps to index strings-1-d.
+  const dots = (lit: (idx: number) => boolean) =>
+    Array.from({ length: strings }, (_, d) => <Dot key={d} $on={lit(strings - 1 - d)} />);
+
+  const active = STRING_WINDOWS.find((w) => w.id === activeId) ?? STRING_WINDOWS[0];
+  const { midi: activeMidi, notes: activeNotes } = cutOf(active);
+  const activeSpan = windowSpan(active);
+
+  return (
+    <Section>
+      <Label>Strings</Label>
+      <Row role="group" aria-label="Which six of the ten strings the guitar plays">
+        {STRING_WINDOWS.map((w) => {
+          const off = disabled.includes(w.id);
+          const isActive = w.id === activeId && view === 'win';
+          const ghost = w.id === activeId && view === 'all';
+          const { notes } = cutOf(w);
+          return (
+            <WinBtn
+              key={w.id}
+              type="button"
+              $active={isActive}
+              $ghost={ghost}
+              disabled={off}
+              aria-pressed={isActive}
+              onClick={() => onPickWindow(w.id)}
+              title={
+                off
+                  ? `Strings ${w.label} won't fit the guitar — a string would land outside the ±12 semitone retuning range`
+                  : ghost
+                    ? `The guitar is on strings ${w.label} — tap to zoom the board to it`
+                    : `Strings ${w.label} — ${w.desc}: ${notes}`
+              }
+            >
+              <DotRow aria-hidden="true">
+                {dots((idx) => idx >= w.i0 && idx < w.i0 + WINDOW_SIZE)}
+              </DotRow>
+              <span>{w.label}</span>
+              <WinNotes>{notes}</WinNotes>
+            </WinBtn>
+          );
+        })}
+        <WinBtn
+          type="button"
+          $active={view === 'all'}
+          aria-pressed={view === 'all'}
+          onClick={onPickAll}
+          title="Show the whole 10-string neck — the strings outside the guitar's group are dimmed"
+        >
+          <DotRow aria-hidden="true">{dots(() => true)}</DotRow>
+          <span>All 10</span>
+          <WinNotes>the full neck</WinNotes>
+        </WinBtn>
+      </Row>
+      {view === 'win' ? (
+        <Hint>
+          <strong>
+            {tuning.name} · strings {active.label}
+          </strong>{' '}
+          — {active.desc}. Voicing (
+          {isReentrant(activeMidi)
+            ? `string ${activeSpan.bottom} → string ${activeSpan.top}`
+            : 'low → high'}
+          ): <strong>{activeNotes}</strong>.
+        </Hint>
+      ) : (
+        <Hint>
+          <strong>{tuning.name} · all 10 strings</strong> — the full neck; the guitar plays{' '}
+          <strong>strings {active.label}</strong> ({activeNotes}) and the strings outside that
+          group are dimmed below.
+        </Hint>
+      )}
+    </Section>
+  );
+};
+
+export default StringWindowBar;
